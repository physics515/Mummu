{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mummu",
  "version": "0.1.0",
  "identifier": "io.basicautomation.mummu",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
